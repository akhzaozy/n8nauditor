# =============================================================================
# SentinelAI - Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# For Portainer deployment, paste these key-values into Portainer Stack "Environment variables".

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=SentinelAI
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=base64:Xk9mQ1J6c1AwOUt6ZldtUW8xNThVUGVvV1ptRnhBOTA=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sentinel
DB_USERNAME=sentinel
DB_PASSWORD=SentinelSecurePass2026!

# Resource limits for DB container
DB_CPU_LIMIT=1.00
DB_MEM_LIMIT=1024M

# -----------------------------------------------------------------------------
# NGINX & LARAVEL WORKER RESOURCE LIMITS
# -----------------------------------------------------------------------------
NGINX_CPU_LIMIT=0.50
NGINX_MEM_LIMIT=256M
APP_CPU_LIMIT=1.50
APP_MEM_LIMIT=1024M
WORKER_CPU_LIMIT=1.00
WORKER_MEM_LIMIT=512M

# -----------------------------------------------------------------------------
# QUEUE & CACHE
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# N8N AUTOMATION ENGINE
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PUBLIC_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://n8n:5678/webhook/sentinel-audit
N8N_CPU_LIMIT=1.00
N8N_MEM_LIMIT=1024M

# -----------------------------------------------------------------------------
# AI PROVIDER SETTINGS (Modular: 9router | openai | ollama)
# -----------------------------------------------------------------------------
# Options: 9router, openai, ollama
AI_PROVIDER=9router

# For 9router:
AI_BASE_URL=https://api.9router.com/v1
AI_API_KEY=your-9router-api-key-here
AI_MODEL=deepseek-chat

# Example for OpenAI:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Example for Local Ollama / DeepSeek:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=deepseek-r1:8b

# -----------------------------------------------------------------------------
# SENTINEL INGEST API & SECURITY
# -----------------------------------------------------------------------------
# Shared secret for authenticating the audit collector and n8n webhooks
SENTINEL_API_SECRET=sentinel-secret-token-change-me

# -----------------------------------------------------------------------------
# NOTIFICATION CHANNELS (Optional, processed by n8n or Laravel Notification)
# -----------------------------------------------------------------------------
NOTIFICATION_DISCORD_WEBHOOK=
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
